rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVE HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string
        && emailId.size() >= 5
        && emailId.size() <= 160
        && emailId.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }

    function authEmailLower() {
      return isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function hasPersonnelDoc() {
      return isSignedIn()
        && authEmailLower().size() >= 5
        && exists(/databases/$(database)/documents/personnel/$(authEmailLower()));
    }

    function myPersonnelData() {
      return get(/databases/$(database)/documents/personnel/$(authEmailLower())).data;
    }

    function hasRole(roleName) {
      return hasPersonnelDoc() && (roleName in myPersonnelData().roles);
    }

    function isDirecteurCedoc() {
      return hasRole('Directeur du CEDoc');
    }

    function isSecretariat() {
      return hasRole('Secrétariat CEDoc');
    }

    function isJury() {
      return hasRole('Jury');
    }

    function isDirecteurThese() {
      return hasRole('Directeur de thèse');
    }

    function isDirecteurLabo() {
      return hasRole('Directeur du laboratoire');
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================

    function isValidCatalogMeta(data) {
      return data.keys().hasAll(['seeded', 'seededBy', 'createdAt'])
        && data.keys().hasOnly(['seeded', 'seededBy', 'createdAt'])
        && data.seeded == true
        && data.seededBy is string && data.seededBy.size() <= 128 && data.seededBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidPersonnel(data) {
      return data.keys().hasAll(['email', 'nom', 'roles', 'laboratoire', 'updatedAt'])
        && data.keys().hasOnly(['email', 'nom', 'roles', 'laboratoire', 'updatedAt'])
        && isValidEmailId(data.email)
        && data.nom is string && data.nom.size() <= 120
        && data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 5
        && data.roles[0] is string && data.roles[0].size() <= 60
        && data.roles.hasOnly([
          'Secrétariat CEDoc',
          'Jury',
          'Directeur de thèse',
          'Directeur du laboratoire',
          'Directeur du CEDoc'
        ])
        && data.laboratoire is string && data.laboratoire.size() <= 80
        && data.updatedAt is timestamp;
    }

    function isValidLaboratoire(data) {
      return data.keys().hasAll(['code', 'nom', 'directeurs', 'disciplines', 'createdAt'])
        && data.keys().hasOnly(['code', 'nom', 'directeurs', 'disciplines', 'createdAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.nom is string && data.nom.size() >= 3 && data.nom.size() <= 180
        && data.directeurs is list && data.directeurs.size() >= 1 && data.directeurs.size() <= 10
        && data.directeurs[0] is string && data.directeurs[0].size() <= 120
        && data.disciplines is list && data.disciplines.size() >= 1 && data.disciplines.size() <= 10
        && data.disciplines[0] is string && data.disciplines[0].size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidSujet(data) {
      return data.keys().hasAll([
          'intitule',
          'description',
          'discipline',
          'directeur',
          'directeurEmail',
          'laboratoire',
          'statut',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'intitule',
          'description',
          'discipline',
          'directeur',
          'directeurEmail',
          'laboratoire',
          'statut',
          'createdAt',
          'updatedAt'
        ])
        && data.intitule is string && data.intitule.size() >= 5 && data.intitule.size() <= 240
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1200
        && data.discipline is string && data.discipline.size() >= 2 && data.discipline.size() <= 120
        && data.directeur is string && data.directeur.size() >= 2 && data.directeur.size() <= 120
        && data.directeurEmail is string && data.directeurEmail.size() <= 160
        && data.laboratoire is string && data.laboratoire.size() >= 2 && data.laboratoire.size() <= 80
        && data.statut in ['En attente', 'Publié', 'Refusé']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCandidature(data) {
      return data.keys().hasAll([
          'candidatId',
          'nom',
          'email',
          'sujetId',
          'sujetIntitule',
          'sujetDescription',
          'sujetDiscipline',
          'directeur',
          'directeurEmail',
          'laboratoire',
          'universiteOrigine',
          'cne',
          'recuperationAuto',
          'statut',
          'nouveauDelai',
          'convocationDate',
          'convocationLieu',
          'recoursDepose',
          'recoursMotif',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'candidatId',
          'nom',
          'email',
          'sujetId',
          'sujetIntitule',
          'sujetDescription',
          'sujetDiscipline',
          'directeur',
          'directeurEmail',
          'laboratoire',
          'universiteOrigine',
          'cne',
          'recuperationAuto',
          'statut',
          'nouveauDelai',
          'convocationDate',
          'convocationLieu',
          'recoursDepose',
          'recoursMotif',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.candidatId)
        && data.nom is string && data.nom.size() >= 1 && data.nom.size() <= 120
        && data.email is string && data.email.size() <= 160
        && isValidId(data.sujetId)
        && data.sujetIntitule is string && data.sujetIntitule.size() <= 240
        && data.sujetDescription is string && data.sujetDescription.size() <= 1200
        && data.sujetDiscipline is string && data.sujetDiscipline.size() <= 120
        && data.directeur is string && data.directeur.size() <= 120
        && data.directeurEmail is string && data.directeurEmail.size() <= 160
        && data.laboratoire is string && data.laboratoire.size() <= 80
        && data.universiteOrigine in ['', 'EST Fès', 'Autre']
        && data.cne is string && data.cne.size() <= 40
        && data.recuperationAuto is bool
        && data.statut in [
          'Compte créé',
          'En dépôt',
          'Envoyée',
          'Incomplet',
          'Complet',
          'Présélectionné',
          'Non présélectionné',
          'Convoqué',
          'Admis',
          'Non admis',
          'Inscrit'
        ]
        && data.nouveauDelai is string && data.nouveauDelai.size() <= 30
        && data.convocationDate is string && data.convocationDate.size() <= 40
        && data.convocationLieu is string && data.convocationLieu.size() <= 160
        && data.recoursDepose is bool
        && data.recoursMotif is string && data.recoursMotif.size() <= 800
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPieceDossier(data, parentOwnerId, slotId) {
      return data.keys().hasAll([
          'ownerId',
          'slotId',
          'label',
          'fileName',
          'mimeType',
          'sizeBytes',
          'storagePath',
          'downloadUrl',
          'sourceAuto',
          'statut',
          'motif',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'slotId',
          'label',
          'fileName',
          'mimeType',
          'sizeBytes',
          'storagePath',
          'downloadUrl',
          'sourceAuto',
          'statut',
          'motif',
          'updatedAt'
        ])
        && data.ownerId == parentOwnerId
        && data.slotId == slotId
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 100
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && data.mimeType is string && data.mimeType.size() <= 80
        && data.sizeBytes is int && data.sizeBytes >= 0 && data.sizeBytes <= 5242880
        && data.storagePath is string && data.storagePath.size() <= 300
        && data.downloadUrl is string && data.downloadUrl.size() <= 1000
        && data.sourceAuto is bool
        && data.statut in ['Manquante', 'Reçue', 'Conforme', 'Non conforme']
        && data.motif is string && data.motif.size() <= 500
        && data.updatedAt is timestamp;
    }

    function isValidPrecontroleIA(data, candidatId, slotId) {
      return data.keys().hasAll(['candidatId', 'slotId', 'statut', 'motif', 'fileName', 'updatedAt'])
        && data.keys().hasOnly(['candidatId', 'slotId', 'statut', 'motif', 'fileName', 'updatedAt'])
        && data.candidatId == candidatId
        && data.slotId == slotId
        && data.statut in ['Conforme', 'Douteux', 'Non conforme']
        && data.motif is string && data.motif.size() <= 500
        && data.fileName is string && data.fileName.size() <= 180
        && data.updatedAt is timestamp;
    }

    function isValidReinscription(data) {
      return data.keys().hasAll([
          'doctorantId',
          'nom',
          'email',
          'annee',
          'sujetIntitule',
          'directeur',
          'laboratoire',
          'statut',
          'nouveauDelai',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'doctorantId',
          'nom',
          'email',
          'annee',
          'sujetIntitule',
          'directeur',
          'laboratoire',
          'statut',
          'nouveauDelai',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.doctorantId)
        && data.nom is string && data.nom.size() >= 1 && data.nom.size() <= 120
        && data.email is string && data.email.size() <= 160
        && data.annee is int && data.annee >= 2 && data.annee <= 6
        && data.sujetIntitule is string && data.sujetIntitule.size() <= 240
        && data.directeur is string && data.directeur.size() <= 120
        && data.laboratoire is string && data.laboratoire.size() <= 80
        && data.statut in ['En dépôt', 'Envoyée', 'Incomplet', 'Validée']
        && data.nouveauDelai is string && data.nouveauDelai.size() <= 30
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicationAdmis(data) {
      return data.keys().hasAll(['valideeParCedoc', 'publieeParSecretariat', 'admis', 'updatedAt'])
        && data.keys().hasOnly(['valideeParCedoc', 'publieeParSecretariat', 'admis', 'updatedAt'])
        && data.valideeParCedoc is bool
        && data.publieeParSecretariat is bool
        && data.admis is list && data.admis.size() <= 200
        && (data.admis.size() == 0 || (data.admis[0] is string && data.admis[0].size() <= 320))
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. One-time catalog initialization marker
    match /catalog_meta/{metaId} {
      allow get: if metaId == 'seeded_v1';
      allow create: if isSignedIn()
        && metaId == 'seeded_v1'
        && isValidCatalogMeta(incoming())
        && incoming().createdAt == request.time
        && !exists(/databases/$(database)/documents/catalog_meta/seeded_v1);
      allow update, delete, list: if false;
    }

    // 2. Personnel (Staff RBAC source of truth)
    match /personnel/{emailId} {
      allow get: if isSignedIn()
        && isValidEmailId(emailId)
        && (authEmailLower() == emailId || isDirecteurCedoc());

      allow list: if isSignedIn()
        && existing().email is string
        && isDirecteurCedoc();

      allow create: if isSignedIn()
        && isValidEmailId(emailId)
        && isValidPersonnel(incoming())
        && incoming().email == emailId
        && incoming().updatedAt == request.time
        && (
          (
            emailId == 'aladinmonroe0@gmail.com'
            && authEmailLower() == 'aladinmonroe0@gmail.com'
            && incoming().roles.size() == 1
            && incoming().roles[0] == 'Directeur du CEDoc'
            && !exists(/databases/$(database)/documents/personnel/aladinmonroe0@gmail.com)
          )
          || isDirecteurCedoc()
        );

      allow update: if isSignedIn()
        && isValidEmailId(emailId)
        && isValidPersonnel(incoming())
        && incoming().email == existing().email
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['nom', 'roles', 'laboratoire', 'updatedAt'])
        && isDirecteurCedoc();

      allow delete: if isSignedIn()
        && isValidEmailId(emailId)
        && emailId != authEmailLower()
        && isDirecteurCedoc();
    }

    // 3. Laboratoires
    match /laboratoires/{labId} {
      allow get: if isValidId(labId) && (resource == null || existing().code is string);
      allow list: if existing().code is string;

      allow create: if isSignedIn()
        && isValidId(labId)
        && isValidLaboratoire(incoming())
        && incoming().createdAt == request.time
        && (
          (
            labId.matches('^lab_init_[a-z0-9]+$')
            && !exists(/databases/$(database)/documents/catalog_meta/seeded_v1)
          )
          || isDirecteurCedoc()
        );

      allow update, delete: if false;
    }

    // 4. Sujets
    match /sujets/{sujetId} {
      allow get: if isValidId(sujetId)
        && (
          (resource != null && existing().statut == 'Publié')
          || (
            isSignedIn() && (
              resource == null
              || (isDirecteurThese() && existing().directeurEmail == authEmailLower())
              || (isDirecteurLabo() && existing().laboratoire == myPersonnelData().laboratoire)
              || isDirecteurCedoc()
              || isSecretariat()
            )
          )
        );

      allow list: if existing().statut == 'Publié'
        || (isSignedIn() && existing().directeurEmail == authEmailLower())
        || (isSignedIn() && existing().statut in ['En attente', 'Publié', 'Refusé'] && isDirecteurLabo() && existing().laboratoire == myPersonnelData().laboratoire)
        || (isSignedIn() && existing().statut in ['En attente', 'Publié', 'Refusé'] && isDirecteurCedoc());

      allow create: if isSignedIn()
        && isValidId(sujetId)
        && isValidSujet(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (
            sujetId.matches('^sujet_init_(0[1-9]|1[0-9]|2[0-7])$')
            && incoming().statut == 'Publié'
            && !exists(/databases/$(database)/documents/catalog_meta/seeded_v1)
          )
          || (
            isDirecteurThese()
            && incoming().statut == 'En attente'
            && incoming().directeurEmail == authEmailLower()
            && incoming().laboratoire == myPersonnelData().laboratoire
          )
        );

      allow update: if isSignedIn()
        && isValidId(sujetId)
        && isValidSujet(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().directeur == existing().directeur
        && incoming().directeurEmail == existing().directeurEmail
        && incoming().laboratoire == existing().laboratoire
        && incoming().updatedAt == request.time
        && (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'updatedAt'])
            && existing().statut == 'En attente'
            && incoming().statut in ['Publié', 'Refusé']
            && isDirecteurLabo()
            && existing().laboratoire == myPersonnelData().laboratoire
          )
          || (
            isDirecteurCedoc()
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // 5. Candidatures
    match /candidatures/{candidatId} {
      allow get: if isSignedIn()
        && isValidId(candidatId)
        && (
          request.auth.uid == candidatId
          || isSecretariat()
          || isJury()
          || isDirecteurCedoc()
          || (resource != null && isDirecteurThese() && existing().directeurEmail == authEmailLower())
        );

      allow list: if isSignedIn()
        && (
          existing().candidatId == request.auth.uid
          || (existing().directeurEmail == authEmailLower() && isDirecteurThese())
          || (existing().statut in ['Envoyée', 'Incomplet', 'Complet', 'Présélectionné', 'Non présélectionné', 'Convoqué', 'Admis', 'Non admis', 'Inscrit'] && (isSecretariat() || isJury() || isDirecteurCedoc()))
        );

      allow create: if isSignedIn()
        && isValidId(candidatId)
        && request.auth.uid == candidatId
        && isValidCandidature(incoming())
        && incoming().candidatId == request.auth.uid
        && incoming().statut in ['Compte créé', 'En dépôt']
        && incoming().nouveauDelai == ''
        && incoming().convocationDate == ''
        && incoming().convocationLieu == ''
        && incoming().recoursDepose == false
        && incoming().recoursMotif == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(candidatId)
        && isValidCandidature(incoming())
        && incoming().candidatId == existing().candidatId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Candidate edits subject, info, or submits before lock
          (
            request.auth.uid == candidatId
            && existing().statut in ['Compte créé', 'En dépôt']
            && incoming().statut in ['Compte créé', 'En dépôt', 'Envoyée']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nom',
              'sujetId',
              'sujetIntitule',
              'sujetDescription',
              'sujetDiscipline',
              'directeur',
              'directeurEmail',
              'laboratoire',
              'universiteOrigine',
              'cne',
              'recuperationAuto',
              'statut',
              'updatedAt'
            ])
          )
          // Candidate re-submits after replacing piece while Incomplet
          || (
            request.auth.uid == candidatId
            && existing().statut == 'Incomplet'
            && incoming().statut == 'Envoyée'
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'updatedAt'])
          )
          // Candidate files a single appeal when Non admis
          || (
            request.auth.uid == candidatId
            && existing().statut == 'Non admis'
            && existing().recoursDepose == false
            && incoming().statut == 'Non admis'
            && incoming().recoursDepose == true
            && incoming().recoursMotif.size() >= 3
            && incoming().diff(existing()).affectedKeys().hasOnly(['recoursDepose', 'recoursMotif', 'updatedAt'])
          )
          // Secretariat declares Complet, Incomplet (+ nouveauDelai), Non admis (expired Incomplet), or Inscrit
          || (
            isSecretariat()
            && existing().statut != 'Inscrit'
            && incoming().statut in ['Complet', 'Incomplet', 'Non admis', 'Inscrit']
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'nouveauDelai', 'updatedAt'])
          )
          // Jury preselects, convokes, or deliberates Admis / Non admis
          || (
            isJury()
            && existing().statut in ['Complet', 'Présélectionné', 'Convoqué']
            && incoming().statut in ['Présélectionné', 'Non présélectionné', 'Convoqué', 'Admis', 'Non admis']
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'convocationDate', 'convocationLieu', 'updatedAt'])
          )
          // CEDoc Director administrative override (non-terminal)
          || (
            isDirecteurCedoc()
            && existing().statut != 'Inscrit'
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'nouveauDelai', 'convocationDate', 'convocationLieu', 'updatedAt'])
          )
        );

      allow delete: if false;

      // 5a. Subcollection: Supporting pieces
      match /pieces/{slotId} {
        allow get: if isSignedIn()
          && isValidId(candidatId)
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && (
            request.auth.uid == candidatId
            || (
              exists(/databases/$(database)/documents/candidatures/$(candidatId))
              && (isSecretariat() || isJury() || isDirecteurCedoc())
            )
          );

        allow list: if isSignedIn()
          && existing().ownerId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(candidatId)
          && request.auth.uid == candidatId
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && isValidPieceDossier(incoming(), candidatId, slotId)
          && incoming().statut == 'Reçue'
          && incoming().motif == ''
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/candidatures/$(candidatId))
          && get(/databases/$(database)/documents/candidatures/$(candidatId)).data.statut in ['Compte créé', 'En dépôt', 'Envoyée', 'Incomplet'];

        allow update: if isSignedIn()
          && isValidId(candidatId)
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && isValidPieceDossier(incoming(), candidatId, slotId)
          && incoming().ownerId == existing().ownerId
          && incoming().slotId == existing().slotId
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/candidatures/$(candidatId))
          && (
            (
              request.auth.uid == candidatId
              && incoming().statut == 'Reçue'
              && incoming().motif == ''
              && get(/databases/$(database)/documents/candidatures/$(candidatId)).data.statut in ['Compte créé', 'En dépôt', 'Envoyée', 'Incomplet']
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'fileName',
                'mimeType',
                'sizeBytes',
                'storagePath',
                'downloadUrl',
                'sourceAuto',
                'statut',
                'motif',
                'updatedAt'
              ])
            )
            || (
              isSecretariat()
              && incoming().statut in ['Conforme', 'Non conforme']
              && get(/databases/$(database)/documents/candidatures/$(candidatId)).data.statut in ['Envoyée', 'Incomplet', 'Complet']
              && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'motif', 'updatedAt'])
            )
          );

        allow delete: if false;
      }

      // 5b. Subcollection: Confidential AI pre-check (STRICTLY Secretariat CEDoc only)
      match /precontrole/{slotId} {
        allow get: if isSignedIn()
          && isValidId(candidatId)
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && exists(/databases/$(database)/documents/candidatures/$(candidatId))
          && isSecretariat();

        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(candidatId)
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && isValidPrecontroleIA(incoming(), candidatId, slotId)
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/candidatures/$(candidatId))
          && isSecretariat();

        allow update: if isSignedIn()
          && isValidId(candidatId)
          && slotId in ['identite', 'diplome', 'releves', 'projet', 'cv']
          && isValidPrecontroleIA(incoming(), candidatId, slotId)
          && incoming().candidatId == existing().candidatId
          && incoming().slotId == existing().slotId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'motif', 'fileName', 'updatedAt'])
          && exists(/databases/$(database)/documents/candidatures/$(candidatId))
          && isSecretariat();

        allow delete: if false;
      }
    }

    // 6. Reinscriptions (Enrolled Doctoral Students)
    match /reinscriptions/{doctorantId} {
      allow get: if isSignedIn()
        && isValidId(doctorantId)
        && (request.auth.uid == doctorantId || isSecretariat() || isDirecteurCedoc());

      allow list: if isSignedIn()
        && (
          existing().doctorantId == request.auth.uid
          || (existing().statut in ['En dépôt', 'Envoyée', 'Incomplet', 'Validée'] && (isSecretariat() || isDirecteurCedoc()))
        );

      allow create: if isSignedIn()
        && isValidId(doctorantId)
        && request.auth.uid == doctorantId
        && isValidReinscription(incoming())
        && incoming().doctorantId == request.auth.uid
        && incoming().statut in ['En dépôt', 'Envoyée']
        && incoming().nouveauDelai == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/candidatures/$(doctorantId))
        && get(/databases/$(database)/documents/candidatures/$(doctorantId)).data.statut == 'Inscrit';

      allow update: if isSignedIn()
        && isValidId(doctorantId)
        && isValidReinscription(incoming())
        && incoming().doctorantId == existing().doctorantId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            request.auth.uid == doctorantId
            && existing().statut in ['En dépôt', 'Incomplet']
            && incoming().statut in ['En dépôt', 'Envoyée']
            && incoming().diff(existing()).affectedKeys().hasOnly(['annee', 'statut', 'updatedAt'])
          )
          || (
            isSecretariat()
            && existing().statut != 'Validée'
            && incoming().statut in ['Incomplet', 'Validée']
            && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'nouveauDelai', 'updatedAt'])
          )
        );

      allow delete: if false;

      match /pieces/{slotId} {
        allow get: if isSignedIn()
          && isValidId(doctorantId)
          && slotId in ['rapport_avancement', 'attestation_encadrant', 'charte_signee']
          && (
            request.auth.uid == doctorantId
            || (
              exists(/databases/$(database)/documents/reinscriptions/$(doctorantId))
              && (isSecretariat() || isDirecteurCedoc())
            )
          );

        allow list: if isSignedIn()
          && existing().ownerId == request.auth.uid;

        allow create: if isSignedIn()
          && isValidId(doctorantId)
          && request.auth.uid == doctorantId
          && slotId in ['rapport_avancement', 'attestation_encadrant', 'charte_signee']
          && isValidPieceDossier(incoming(), doctorantId, slotId)
          && incoming().statut == 'Reçue'
          && incoming().motif == ''
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/reinscriptions/$(doctorantId))
          && get(/databases/$(database)/documents/reinscriptions/$(doctorantId)).data.statut in ['En dépôt', 'Envoyée', 'Incomplet'];

        allow update: if isSignedIn()
          && isValidId(doctorantId)
          && slotId in ['rapport_avancement', 'attestation_encadrant', 'charte_signee']
          && isValidPieceDossier(incoming(), doctorantId, slotId)
          && incoming().ownerId == existing().ownerId
          && incoming().slotId == existing().slotId
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/reinscriptions/$(doctorantId))
          && (
            (
              request.auth.uid == doctorantId
              && incoming().statut == 'Reçue'
              && incoming().motif == ''
              && get(/databases/$(database)/documents/reinscriptions/$(doctorantId)).data.statut in ['En dépôt', 'Envoyée', 'Incomplet']
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'fileName',
                'mimeType',
                'sizeBytes',
                'storagePath',
                'downloadUrl',
                'sourceAuto',
                'statut',
                'motif',
                'updatedAt'
              ])
            )
            || (
              isSecretariat()
              && incoming().statut in ['Conforme', 'Non conforme']
              && get(/databases/$(database)/documents/reinscriptions/$(doctorantId)).data.statut in ['Envoyée', 'Incomplet']
              && incoming().diff(existing()).affectedKeys().hasOnly(['statut', 'motif', 'updatedAt'])
            )
          );

        allow delete: if false;
      }
    }

    // 7. Official Admitted List Publication
    match /publication_admis/{pubId} {
      allow get: if pubId == 'officielle'
        && (
          resource == null
          || existing().publieeParSecretariat == true
          || (isSignedIn() && (isSecretariat() || isDirecteurCedoc() || isJury()))
        );

      allow list: if false;

      allow create: if isSignedIn()
        && pubId == 'officielle'
        && isValidPublicationAdmis(incoming())
        && incoming().valideeParCedoc == true
        && incoming().publieeParSecretariat == false
        && incoming().updatedAt == request.time
        && isDirecteurCedoc();

      allow update: if isSignedIn()
        && pubId == 'officielle'
        && isValidPublicationAdmis(incoming())
        && incoming().updatedAt == request.time
        && (
          (
            isDirecteurCedoc()
            && incoming().valideeParCedoc == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['valideeParCedoc', 'publieeParSecretariat', 'admis', 'updatedAt'])
          )
          || (
            isSecretariat()
            && existing().valideeParCedoc == true
            && incoming().valideeParCedoc == true
            && incoming().publieeParSecretariat == true
            && incoming().admis == existing().admis
            && incoming().diff(existing()).affectedKeys().hasOnly(['publieeParSecretariat', 'updatedAt'])
          )
        );

      allow delete: if false;
    }
  }
}
